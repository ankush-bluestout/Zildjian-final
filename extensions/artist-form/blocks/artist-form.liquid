
{% comment %}
  Artist Form — plain HTML version (no React).
  Edit the markup below directly like normal HTML.

  Behaviour is added by assets/artist-form.js. It hooks onto these attributes,
  so keep them when editing:
    - id="artist-form-root"      (the mount wrapper + data-* config)
    - id="artist-form"           (the <form>)
    - class="sidebar-link" / "mobile-tab" with href="#sX"   (nav)
    - id="s1".."s8"              (section anchors, must match the nav hrefs)
    - name="..."                 (every field you want submitted)
    - class="product-search" data-group="gotos"            (Go-To's picker)
    - class="cymbal-picker" data-group="cymbals"           (Cymbal checklist)
    - class="upload-box" data-upload="profilePhoto|setupPhoto"  (photo pickers)
    - class="quote-count"        (character counter text)
    - [data-alert]               (success/error message target)
    - class="submit-btn"         (submit button)
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet"> 
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
{{ 'artist-form.css' | asset_url | stylesheet_tag }}

<style>
  /* ---- Cymbal picker (browse checklist + selected chips) ---- */
  .cymbal-picker {    border-radius: 2px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #E3D0A6;    
}     
  .cymbal-picker .cp-search { 
        display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid #E3D0A6;
  }
  .cymbal-picker .cp-input { 
      flex: 1;
    border: 0;
    background: #F8F8F9;
    outline: none;
    color: #5C5D60;
    padding: 12px 16px;
    font-family: Century Gothic !important;
    font-weight: 400;
    font-size: 14px;
    line-height: 22px;
    letter-spacing: 0px;
        box-shadow: unset;    
   }
  .cymbal-picker .cp-input::placeholder { color: #5C5D60; }
  .cymbal-picker .cp-list { 
      max-height: 250px;
    overflow-y: auto;
    background: #F8F8F9;
        scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
}   

.cymbal-picker .cp-list::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
}   
  .cymbal-picker .cp-row { display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    cursor: pointer;
    margin: 0;
  }     
  .cymbal-picker .cp-row:hover { background: #fafafa; }
  .cymbal-picker .cp-row.selected { background: #FBF3DC; }


.cymbal-picker .cp-check {
    width: 16px;
    height: 16px;
    flex: none;
    cursor: pointer;  
    margin: 0;

    appearance: none;
    -webkit-appearance: none;

    background: #fff;     
    border: 1px solid #777;
    border-radius: 2.5px;
    box-sizing: border-box;
}

.cymbal-picker .cp-check:checked {
    background: #B8860B;
    border-color: #B8860B;
}

.cymbal-picker .cp-thumb {
 width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #F5F4F0;
    flex: none;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E8E6E0;
}
  .cymbal-picker .cp-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .cymbal-picker .cp-info { min-width: 0; }
  .cymbal-picker .cp-title { 
  color: #000000;
    font-family: Century Gothic;
    font-weight: 400;
    font-size: 13px;
    line-height: 22px;
    letter-spacing: 1px;
}
  .cymbal-picker .cp-sub { 
      color: #666666;
    margin-top: 2px;
    font-family: Montserrat;
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0px;

  }
  .cymbal-picker .cp-empty { padding: 26px 16px; text-align: center; color: #aaa; font-size: 13px; }
  .cymbal-picker .cp-footer { 
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-top: 1px solid #E3D0A6;
    background: #FFFFFF;
    gap: 5px;
        font-family: Montserrat;
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0px;
    color: #666666;
  } 
      .cymbal-picker .cp-filter strong { color: #222; }
  .cymbal-picker .cp-clear { color: #B8860B; text-decoration: none; }
  .cymbal-picker .cp-clear:hover { text-decoration: underline; }

  .cp-selected { 
        display: flex;
    align-items: center;
    padding: 12px;
    background: #F8F8F9;
    font-weight: 400; 
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0px;
    gap: 6px;
    flex-wrap: wrap;  
  }
  .cp-chip { 
        display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border: 1px solid #d9b45b;
    background: #FBF3DC;
    font-family: Montserrat;
    font-weight: 400;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0px;
    }
  .cp-chip-title { color: #222; font-weight: 500; }
  .cp-chip-sub { color: #999; font-size: 12px; }
  .cp-chip-x {
  cursor: pointer;
    color: #C8A951;
    padding-left: 2px;
    font-family: Barlow;
    font-weight: 500;
    font-size: 13px;
    line-height: 13px;
    letter-spacing: 0%;
    vertical-align: middle;
      }
  .cp-chip-x:hover { color: #b8860b; }
</style>

<div id="artist-form-root"
     data-proxy-url="{{ block.settings.proxy_url | default: '/apps/artist-form/submit' }}"
     data-search-url="{{ block.settings.search_url | default: '/apps/artist-form/search' }}">

  <!-- Mobile tab bar -->
  <nav class="mobile-tabs">
    <a href="#s1" class="mobile-tab active"><span class="tab-num">01</span><span class="tab-label">Info</span></a>
    <a href="#s2" class="mobile-tab"><span class="tab-num">02</span><span class="tab-label">Quote</span></a>
    <a href="#s3" class="mobile-tab"><span class="tab-num">03</span><span class="tab-label">Setup</span></a>
    <a href="#s4" class="mobile-tab"><span class="tab-num">04</span><span class="tab-label">Go-To's</span></a>
    <a href="#s5" class="mobile-tab"><span class="tab-num">05</span><span class="tab-label">Social</span></a>
    <a href="#s6" class="mobile-tab"><span class="tab-num">06</span><span class="tab-label">Profile</span></a>
    <a href="#s7" class="mobile-tab"><span class="tab-num">07</span><span class="tab-label">Setup Photo</span></a>
    <a href="#s8" class="mobile-tab"><span class="tab-num">08</span><span class="tab-label">Videos</span></a>
  </nav>

  <div class="layout main-layout">

    <!-- Sidebar nav -->
    <aside class="sidebar">
      <div class="sidebar-group-label">Artist Info</div>
      <a href="#s1" class="sidebar-link active"><strong>01</strong>Artist Info<span class="plus"></span></a>
      <a href="#s2" class="sidebar-link"><strong>02</strong>Your Quote<span class="plus"></span></a>

      <div class="sidebar-group-label">Setup</div>
      <a href="#s3" class="sidebar-link"><strong>03</strong>Cymbal Setup<span class="plus"></span></a>
      <a href="#s4" class="sidebar-link"><strong>04</strong>Go-To's<span class="plus"></span></a>

      <div class="sidebar-group-label">Online</div>
      <a href="#s5" class="sidebar-link"><strong>05</strong>Website &amp; Socials<span class="plus"></span></a>

      <div class="sidebar-group-label">Media</div>
      <a href="#s6" class="sidebar-link"><strong>06</strong>Profile Photo<span class="plus"></span></a>
      <a href="#s7" class="sidebar-link"><strong>07</strong>Setup Photo<span class="plus"></span></a>
      <a href="#s8" class="sidebar-link"><strong>08</strong>Videos<span class="plus"></span></a>
    </aside>

    <main class="main">
      <form id="artist-form" novalidate>

        <!-- 01 Artist Information -->
        <section id="s1">    
          <div class="section-heading"><span>01</span>Artist Information</div>

             <div class="field-row-wrap">
            <div class="field-group">
              <label class="field-label">Name <span class="req">★</span></label>
              <div class="field-hint">Artist name you prefer on site.</div>
              <input class="field-input" name="name" type="text" placeholder="e.g. Mimmo Di Cicco" required>
            </div>
            <div class="field-group">
              <label class="field-label">Band / Affiliation <span class="req">★</span></label>
              <div class="field-hint">Who are you currently playing with?</div>
              <input class="field-input" name="band" type="text" placeholder="e.g. Independent" required>
            </div>

            <div class="field-group">
              <label class="field-label">Artist Type <span class="req">★</span></label>
              <select class="field-input" name="artistType" required>
                <option value="">Sele an option...</option>
                <option>Professional</option>
                <option>Semi-Professional</option>
                <option>Hobbyist</option>
              </select>
            </div>
            <div class="field-group">
              <label class="field-label">Are you an Educator or Performer? <span class="req">★</span></label>
              <select class="field-input" name="role" required>
                <option value="">Select an option...</option>
                <option>Educator</option>
                <option>Performer</option>
                <option>Both</option>
              </select>
            </div>

          <div class="field-group full-field-group">
            <label class="field-label">Country <span class="req">★</span></label>
       <select class="field-input" name="country" data-searchable="true" required>
  <option value="">Select your country...</option>
  <option>United States</option>
  <option>United Kingdom</option>
  <option>Canada</option>
  <option>Australia</option>
  <option>Germany</option>
  <option>France</option>
  <option>Japan</option>
</select>
               </div>
          </div>
        </section>

        <!-- 02 Quote -->
        <section id="s2">
          <div class="section-heading"><span>02</span>Your Zildjian Quote</div>
          <div class="field-group">
            <label class="field-label">Why do you choose Zildjian? <span class="req">★</span></label>
            <div class="field-hint">This is the quote that will appear on your artist page. Please read it carefully.</div>
            <div class="field-input-wrapper">
            <textarea class="field-input" name="quote" placeholder="Share what Zildjian means to you, in your own words..." rows="6" maxlength="400" style="resize:vertical;line-height:1.5" required></textarea>
            <div class="quote-count">0 / 400</div>
            </div>
          </div>
        </section>

        <!-- 03 Cymbal Setup (browse checklist) -->
        <section id="s3">
          <div class="section-heading"><span>03</span>Cymbal Setup</div>
          <div class="field-group">
            <label class="field-label">What's in Your Setup? <span class="req">★</span></label>
            <div class="field-hint">Select the cymbals in your setup from left to right.</div>

         
               <div class="cymbal-picker" data-group="cymbals" data-mode="browse">
              <div class="cp-search">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 14 14" fill="none">
                  <path d="M6.41667 11.0833C8.994 11.0833 11.0833 8.994 11.0833 6.41667C11.0833 3.83934 8.994 1.75 6.41667 1.75C3.83934 1.75 1.75 3.83934 1.75 6.41667C1.75 8.994 3.83934 11.0833 6.41667 11.0833Z" stroke="#000000" stroke-width="1.16667"/>
                  <path d="M12.2499 12.25L9.7124 9.71252" stroke="#000000" stroke-width="1.16667"/>
                </svg>
                <input type="text" class="cp-input" placeholder="Search cymbals by name...">
              </div>
              <div class="cp-list"></div>
              <div class="cp-footer">
                <span class="cp-filter">Filter: <strong>Cymbals only</strong></span>
                <span class="cp-actions"><span class="cp-count">0 selected</span> · <a class="cp-clear" href="#">Clear all</a></span>
              </div>
              <div class="cp-selected" hidden></div>
            </div>

            <!-- selected chips strip -->
            
     <!-- manual cymbal entry -->
            <div class="manual-cymbals" style="">
              <label class="field-label manual-label">Can't find a cymbal? Add it manually</label>
              <div class="field-hint">One cymbal per line — include the size and model (e.g. 22" K Custom Special Dry Ride).</div>
              <textarea class="field-input manual-input" name="cymbalsManual" rows="4"
                placeholder="22&quot; K Custom Special Dry Hi-Hats&#10;16&quot; K Custom Special Dry Hi-Hats"></textarea>
              <div class="manual-hint"><strong>One cymbal per line</strong></div>
            </div>

          </div>    
        </section>

        {% comment %} <!-- 04 Go-To's (live product search) -->
        <section id="s4" >
          <div class="section-heading"><span>04</span>Go-To's</div>
          <div class="field-group">
            <label class="field-label">What are your Go-To's?</label>
            <div class="field-hint">Search all Zildjian products — must-have cymbals, sticks, apparel, bags, etc.</div>

            <div class="product-search" data-group="gotos">
              <div class="ps-input-wrap">
                <svg class="ps-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" class="field-input ps-input" placeholder="Search all Zildjian products...">
                <div class="search-results" hidden></div>
