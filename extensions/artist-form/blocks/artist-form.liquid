        <!-- 06 Profile Photo -->
        <section id="s6" >
          <div class="section-heading"><span>06</span>Profile Photo</div>
          <div class="field-group">
            <label class="field-label">Profile Picture <span class="req">★</span></label>
            <div class="field-hint">This is the photo visitors will see first when viewing your artist page. Please attach the highest resolution file you can.</div>
            <div class="upload-box" data-upload="profilePhoto">
              <input type="file" accept="image/*" class="upload-input" hidden>
              <div class="upload-icon">↑</div>
              <div class="upload-desktop">Drop your photo here or <span class="upload-link">browse files</span></div>
                <div class="upload-desktop hidden"><span class="upload-link">Profile photo required</span></div>
                <div class="upload-mobile hidden">Drop an image here or click to browse</div>
              <div class="upload-mobile"><span>JPG, PNG, TIFF ·</span> Horizontal image preferred</div>
              
              <div class="upload-file"></div>
              {% comment %} <div style="font-size:11px;color:#bbb">Min. 1000px wide recommended</div> {% endcomment %}
            </div>
          </div>
          <div class="field-group margin-field-group">
            <label class="field-label">Profile Picture Credit </label>
            <div class="field-hint">Please add the appropriate photo credit here, if applicable.</div>
            <input class="field-input" name="profileCredit" type="text" placeholder="e.g. Photo by John Smith">
          </div>
          <div class="field-group ">
            <label class="field-label">Profile Picture Rights <span class="req">★</span></label>
            <div class="field-hint">Do we have the rights to use / edit this image?</div>
            <label class="radio-line"><input type="radio" name="profileRights" value="Website and marketing"> Yes, for both the website and marketing.</label>
            <label class="radio-line"><input type="radio" name="profileRights" value="Website only"> Yes, but for the website only.</label>
          </div>
        </section>

        <!-- 07 Setup Photo -->
        <section id="s7">
          <div class="section-heading"><span>07</span>Setup Photo</div>
          <div class="field-group">
            <label class="field-label">Setup Picture <span class="req">★</span></label>
            <div class="field-hint">This is the photo that will appear next to your cymbal setup. Ideally an over-the-top or full kit shot. <strong>Horizontal image preferred.</strong></div>
            <div class="upload-box" data-upload="setupPhoto">
              <input type="file" accept="image/*" class="upload-input" hidden>
              <div class="upload-icon">↑</div>
            <div class="upload-desktop">Drop your photo here or <span class="upload-link">browse files</span></div>
                <div class="upload-desktop hidden"><span class="upload-link">Profile photo required</span></div>
                <div class="upload-mobile hidden">Drop an image here or click to browse</div>
              <div class="upload-mobile"><span>JPG, PNG, TIFF ·</span> Horizontal image preferred</div>
              
              <div class="upload-file"></div>
            </div>
          </div>
          <div class="field-group margin-field-group">
            <label class="field-label">Setup Picture Credit </label>
            <div class="field-hint">Please add the appropriate photo credit here, if applicable.</div>
            <input class="field-input" name="setupCredit" type="text" placeholder="e.g. Photo by Jane Doe">
          </div>
          <div class="field-group">
            <label class="field-label">Setup Picture Rights <span class="req">★</span></label>
            <div class="field-hint">Do we have the rights to use / edit this image?</div>
            <label class="radio-line"><input type="radio" name="setupRights" value="Website and marketing"> Yes, for both the website and marketing.</label>
            <label class="radio-line"><input type="radio" name="setupRights" value="Website only"> Yes, but for the website only.</label>
          </div>
        </section>

        <!-- 08 Videos -->
        <section id="s8" >
          <div class="section-heading"><span>08</span>Videos</div>
          <div class="field-group input_video">
            <label class="field-label">Video 1</label>
            <div class="field-hint">You can include up to 2 performance videos on your artist page. Please include the full URL.</div>
            <input class="field-input" name="video1" type="url" placeholder="https://youtu.be/... or https://vimeo.com/...">
          </div>
          <div class="field-group input_video video_2">
            <label class="field-label">Video 2</label>
            <div class="field-hint">Additional video you would like to feature. Please list the full URL.</div>
            <input class="field-input" name="video2" type="url" placeholder="https://youtube.com/... or https://vimeo.com/...">
          </div>

          <div class="form-alert" data-alert hidden></div>

          

        </section>
        <section class="bottom_content_wrap">
          <p>    By submitting this form you confirm that all information provided is accurate and that you have the rights to use the submitted images. Contact your Artist Relations manager with any questions.</p>
          <button class="submit-btn" type="submit">Submit Profile</button>
          <div class="btn_btm_text">Once submitted, you will be moved to a confirmation screen.</div>
          </section >

      </form>
    </main>
  </div>





</div>

  <!-- Success modal -->
  <div class="success-modal" data-success-modal hidden >
    <div class="success-card">    
      <div class="success-check">
        <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 72 72" fill="none">
<rect x="1" y="1" width="70" height="70" rx="35" stroke="#CC9F53" stroke-width="2"/>
<path d="M46.6668 28L32.0002 42.6667L25.3335 36" stroke="#CC9F53" stroke-width="2"/>
</svg>    
      </div>
      <h2 class="success-title">Profile Submitted</h2>
      <p class="success-text">Thank you! Your artist profile has been submitted successfully. Due to the large number of entries, there may be a delay before your page goes live. Contact your Artist Relations Manager with any questions.</p>
      <div class="success-actions">
        <a class="success-btn primary" href="{{ block.settings.roster_url | default: '/pages/artist-roster' }}">View Artist Roster</a>

        <a class="success-btn" href="{{ block.settings.home_url | default: '/' }}" data-hide-form>Back to Zildjian</a>

      </div>
    </div>
  </div>


<script src="{{ 'artist-form.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Artist Form",
  "target": "section",
  "settings": [     
    {
      "type": "text",
      "id": "proxy_url",
      "label": "Submit URL (app proxy path)",
      "default": "/apps/artist-form/submit",
      "info": "Must match the app proxy subpath in shopify.app.toml."
    },
    {
      "type": "text",
      "id": "search_url",
      "label": "Product search URL (app proxy path)",
      "default": "/apps/artist-form/search",
      "info": "Same app proxy subpath, /search path."
    },

     {
      "type": "url",
      "id": "roster_url",
      "label": "\"View Artist Roster\" link",
      "info": "Where the roster button goes after submission."
    },
    {
      "type": "url",
      "id": "home_url",
      "label": "\"Back to Zildjian\" link",
      "info": "Where the back button goes."
    }
  ]
}
{% endschema %}
